{
  "expo": {
    "name": "Printer Tracker",
    "slug": "printer-tracker",
    "version": "1.0.0",
    "scheme": "printertracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Printer Tracker to use the camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Printer Tracker to access your photos."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
